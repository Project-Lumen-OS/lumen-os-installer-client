<Window x:Class="LumenInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:LumenInstaller.Core"
        xmlns:v="clr-namespace:LumenInstaller.Views"
        Title="Lumen Installer" Width="1240" Height="820" MinWidth="1040" MinHeight="680"
        Background="{StaticResource Bg}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        Icon="Assets/app.ico" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <v:BoolToOn x:Key="On"/>
    <v:TextToVisibility x:Key="TextVis"/>

    <Style TargetType="v:NavItem" BasedOn="{StaticResource Plain}">
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="v:NavItem">
            <Border x:Name="b" CornerRadius="10" Padding="10,8" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid Width="22" Height="22" VerticalAlignment="Center">
                  <Ellipse x:Name="ring" Stroke="{StaticResource Line2}" StrokeThickness="1"/>
                  <TextBlock x:Name="num" Text="{TemplateBinding Number}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <TextBlock x:Name="chk" Text="✓" FontSize="12" FontWeight="Bold" Foreground="{StaticResource OkDark}" Visibility="Collapsed"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                  <TextBlock x:Name="title" Text="{TemplateBinding Title}" FontSize="13.5" FontWeight="Medium" Foreground="{StaticResource Muted}"/>
                  <TextBlock Text="{TemplateBinding Sub}" FontSize="11.5" Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                             Visibility="{Binding Sub, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TextVis}}"/>
                </StackPanel>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Done" Value="True">
                <Setter TargetName="ring" Property="Fill" Value="{StaticResource Ok}"/>
                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Ok}"/>
                <Setter TargetName="num" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="Active" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1C7EA6FF"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#477EA6FF"/>
                <Setter TargetName="title" Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="title" Property="Foreground" Value="{StaticResource Text}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- one step of the install pipeline: a half line, the circle, a half line; the title and why it was skipped -->
    <DataTemplate x:Key="PipeStep">
      <StackPanel>
        <Grid Height="28">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Rectangle x:Name="l" Height="2" Fill="{StaticResource Line2}"/>
          <Rectangle x:Name="r" Grid.Column="2" Height="2" Fill="{StaticResource Line2}"/>
          <Ellipse x:Name="c" Grid.Column="1" Fill="{StaticResource PanelSolid}" Stroke="{StaticResource Line2}" StrokeThickness="2"/>
          <TextBlock x:Name="n" Grid.Column="1" Text="{Binding Number}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock x:Name="t" Text="{Binding Title}" FontSize="11.5" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="2,7,2,0"/>
        <TextBlock Text="{Binding Note}" FontSize="10.5" Foreground="{StaticResource Faint}" TextAlignment="Center" Margin="2,1,2,0"
                   Visibility="{Binding HasNote, Converter={StaticResource Vis}}"/>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding LeftState}" Value="none"><Setter TargetName="l" Property="Visibility" Value="Hidden"/></DataTrigger>
        <DataTrigger Binding="{Binding LeftState}" Value="on"><Setter TargetName="l" Property="Fill" Value="{StaticResource Ok}"/></DataTrigger>
        <DataTrigger Binding="{Binding RightState}" Value="none"><Setter TargetName="r" Property="Visibility" Value="Hidden"/></DataTrigger>
        <DataTrigger Binding="{Binding RightState}" Value="on"><Setter TargetName="r" Property="Fill" Value="{StaticResource Ok}"/></DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="done">
          <Setter TargetName="c" Property="Fill" Value="{StaticResource Ok}"/><Setter TargetName="c" Property="Stroke" Value="{StaticResource Ok}"/>
          <Setter TargetName="n" Property="Text" Value="✓"/><Setter TargetName="n" Property="Foreground" Value="{StaticResource OkDark}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="cur">
          <Setter TargetName="c" Property="Stroke" Value="{StaticResource Accent}"/><Setter TargetName="n" Property="Foreground" Value="{StaticResource Accent}"/>
          <Setter TargetName="t" Property="Foreground" Value="{StaticResource Text}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="skip">
          <Setter TargetName="c" Property="StrokeDashArray" Value="2 2"/><Setter TargetName="n" Property="Foreground" Value="{StaticResource Faint}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="fail">
          <Setter TargetName="c" Property="Stroke" Value="{StaticResource Bad}"/><Setter TargetName="n" Property="Text" Value="✕"/>
          <Setter TargetName="n" Property="Foreground" Value="{StaticResource Bad}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <!-- night sky -->
    <Grid IsHitTestVisible="False">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#0B0D17" Offset="0"/><GradientStop Color="#0E1124" Offset="0.6"/><GradientStop Color="#0B0D17" Offset="1"/>
        </LinearGradientBrush>
      </Grid.Background>
      <Rectangle>
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.9,-0.05" GradientOrigin="0.9,-0.05" RadiusX="0.6" RadiusY="0.8">
            <GradientStop Color="#2EFF9B5E" Offset="0"/><GradientStop Color="#00FF9B5E" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Rectangle>
        <Rectangle.Fill>
          <RadialGradientBrush Center="0.05,1.1" GradientOrigin="0.05,1.1" RadiusX="0.6" RadiusY="0.8">
            <GradientStop Color="#2B596EFF" Offset="0"/><GradientStop Color="#00596EFF" Offset="1"/>
          </RadialGradientBrush>
        </Rectangle.Fill>
      </Rectangle>
      <Canvas x:Name="Stars"/>
    </Grid>

    <!-- ================================================================ welcome -->
    <Grid Visibility="{Binding IsWelcome, Converter={StaticResource Vis}}" Margin="64,40,64,30">
      <StackPanel VerticalAlignment="Center" MaxWidth="860" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
          <Image Source="Assets/logo.png" Width="58" Height="58">
            <Image.Clip><RectangleGeometry Rect="0,0,58,58" RadiusX="16" RadiusY="16"/></Image.Clip>
          </Image>
          <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Lumen Installer" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
            <TextBlock Text="{c:T app.sub}" FontSize="32" FontWeight="Bold"/>
          </StackPanel>
        </StackPanel>
        <Border Height="30"/>
        <UniformGrid Columns="1" MaxWidth="410" HorizontalAlignment="Left">
          <Button Style="{StaticResource Plain}" Command="{Binding ChooseRealCmd}">
            <Border Style="{StaticResource Card}" Padding="22" CornerRadius="18" Margin="0" MinHeight="220">
              <DockPanel>
                <Border DockPanel.Dock="Top" Width="46" Height="46" CornerRadius="12" Background="#21FFC76B" HorizontalAlignment="Left" Margin="0,0,0,14">
                  <TextBlock Text="⇄" FontSize="22" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock DockPanel.Dock="Top" Text="{c:T welcome.real.title}" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock DockPanel.Dock="Bottom" Text="{c:T welcome.start}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Text="{c:T welcome.real.text}" Style="{StaticResource Small}" FontSize="13.5" Margin="0,6,0,0"/>
              </DockPanel>
            </Border>
          </Button>
        </UniformGrid>
        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
          <TextBlock Text="{c:T lang}" Foreground="{StaticResource Faint}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
          <Button Style="{StaticResource Chip}" Content="Русский" Command="{Binding SetLangCmd}" CommandParameter="ru" Tag="{Binding L.IsRu, Converter={StaticResource On}}"/>
          <Button Style="{StaticResource Chip}" Content="English" Command="{Binding SetLangCmd}" CommandParameter="en" Tag="{Binding L.IsEn, Converter={StaticResource On}}"/>
          <Button Style="{StaticResource Chip}" Content="中文" Command="{Binding SetLangCmd}" CommandParameter="zh" Tag="{Binding L.IsZh, Converter={StaticResource On}}"/>
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- ================================================================ wizard -->
    <Grid Visibility="{Binding ModeChosen, Converter={StaticResource Vis}}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <!-- sidebar -->
      <Border Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <DockPanel Margin="12,22,12,14">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,20">
            <Image Source="Assets/logo.png" Width="38" Height="38">
              <Image.Clip><RectangleGeometry Rect="0,0,38,38" RadiusX="11" RadiusY="11"/></Image.Clip>
            </Image>
            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Lumen Installer" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <StackPanel Orientation="Horizontal" Margin="10,0,0,12">
              <Button Style="{StaticResource Chip}" Content="RU" Command="{Binding SetLangCmd}" CommandParameter="ru" Tag="{Binding L.IsRu, Converter={StaticResource On}}"/>
              <Button Style="{StaticResource Chip}" Content="EN" Command="{Binding SetLangCmd}" CommandParameter="en" Tag="{Binding L.IsEn, Converter={StaticResource On}}"/>
              <Button Style="{StaticResource Chip}" Content="中文" Command="{Binding SetLangCmd}" CommandParameter="zh" Tag="{Binding L.IsZh, Converter={StaticResource On}}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
              <Button Style="{StaticResource Link}" Content="{c:T side.guide}" Command="{Binding OpenGuideCmd}" Visibility="{Binding HasProfile, Converter={StaticResource Vis}}"/>
              <Button Style="{StaticResource Link}" Content="Telegram" Command="{Binding OpenUrlCmd}" CommandParameter="https://t.me/projector_lumenos"/>
              <Button Style="{StaticResource Link}" Content="{c:T side.leave}" Command="{Binding LeaveCmd}"/>
            </StackPanel>
          </StackPanel>
          <StackPanel>
            <v:NavItem Number="1" Title="{c:T side.prep}" Active="{Binding IsPrepare}" Command="{Binding GoStepCmd}" CommandParameter="-1"/>
            <v:NavItem Number="2" Title="{c:T side.step0}" Sub="{Binding Step0Sub}" Active="{Binding IsStep0}" Command="{Binding GoStepCmd}" CommandParameter="0"/>
            <v:NavItem Number="3" Title="{c:T side.step1}" Sub="{Binding Step1Sub}" Active="{Binding IsStep1}" Command="{Binding GoStepCmd}" CommandParameter="1" IsEnabled="{Binding Step1Enabled}"/>
            <v:NavItem Number="4" Title="{c:T side.step2}" Sub="{Binding Step2Sub}" Active="{Binding IsStep2}" Command="{Binding GoStepCmd}" CommandParameter="2" IsEnabled="{Binding Step2Enabled}"/>
            <v:NavItem Number="5" Title="{c:T side.step3}" Sub="{Binding Step3Sub}" Done="{Binding InstallDone}" Active="{Binding IsStep3}" Command="{Binding GoStepCmd}" CommandParameter="3" IsEnabled="{Binding Step3Enabled}"/>

            <TextBlock Text="{c:T side.maint}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Faint}" Margin="10,22,0,4"/>
            <Button Style="{StaticResource Maint}" Content="{c:T side.check}" Command="{Binding MaintCmd}" CommandParameter="check" IsEnabled="{Binding MaintEnabled}"/>
            <Button Style="{StaticResource Maint}" Content="{c:T side.verify}" Command="{Binding MaintCmd}" CommandParameter="verify" IsEnabled="{Binding MaintEnabled}"/>
            <Button Style="{StaticResource Maint}" Content="{c:T side.gapps}" Command="{Binding MaintCmd}" CommandParameter="gapps" IsEnabled="{Binding MaintEnabled}"/>
            <Button Style="{StaticResource Maint}" Content="{c:T side.status}" Command="{Binding MaintCmd}" CommandParameter="status" IsEnabled="{Binding StatusEnabled}"/>
            <TextBlock Text="{c:T side.maint.hint}" FontSize="11" Foreground="{StaticResource Faint}" Margin="10,4,0,0"
                       Visibility="{Binding Connected, Converter={StaticResource NotVis}}"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- content -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" Margin="40,40,40,40">

          <!-- ============ step 1: the projector -->
          <StackPanel Visibility="{Binding IsPrepare, Converter={StaticResource Vis}}">
            <TextBlock Text="{c:T prep.title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{c:T prep.lead}" Style="{StaticResource Lead}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <Button Style="{StaticResource Chip}" Content="XGIMI Z9X" Command="{Binding SetPrepModelCmd}" CommandParameter="z9x" Tag="{Binding PrepZ9x, Converter={StaticResource On}}"/>
              <Button Style="{StaticResource Chip}" Content="XGIMI Play 6" Command="{Binding SetPrepModelCmd}" CommandParameter="play6" Tag="{Binding PrepPlay6, Converter={StaticResource On}}"/>
              <Button Style="{StaticResource Chip}" Content="XGIMI Z9X HB" Command="{Binding SetPrepModelCmd}" CommandParameter="hb" Tag="{Binding PrepHb, Converter={StaticResource On}}"/>
            </StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <ItemsControl ItemsSource="{Binding PrepSteps}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding}" FontSize="13.5" TextWrapping="Wrap" Margin="0,0,0,8"/></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{c:T prep.menus}" Style="{StaticResource Small}" FontSize="12" Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <Button Style="{StaticResource Link}" Content="{c:T prep.guide}" Command="{Binding PrepGuideCmd}" Foreground="{StaticResource Blue}" HorizontalAlignment="Left"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Visibility="{Binding TunerVisible, Converter={StaticResource Vis}}">
              <StackPanel>
                <TextBlock Text="{Binding TunerTitle}" Style="{StaticResource H2}"/>
                <TextBlock Text="{c:T tuner.text}" Style="{StaticResource Small}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource BtnSmall}" Content="{c:T tuner.download}" Command="{Binding TunerDownloadCmd}" Visibility="{Binding TunerNotReady, Converter={StaticResource Vis}}" IsEnabled="{Binding TunerIdle}"/>
                  <Button Style="{StaticResource BtnSmall}" Content="{c:T tuner.save}" Command="{Binding TunerSaveCmd}" Visibility="{Binding TunerReady, Converter={StaticResource Vis}}"/>
                  <Button Style="{StaticResource Link}" Content="{c:T tuner.source}" Command="{Binding TunerSourceCmd}" Foreground="{StaticResource Blue}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ProgressBar Value="{Binding TunerProgress}" Maximum="1" Height="4" Margin="0,10,0,0" Visibility="{Binding TunerDownloading, Converter={StaticResource Vis}}"/>
                <TextBlock Text="{Binding TunerMessage}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding TunerStickNote}" Style="{StaticResource Small}" FontSize="12" Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
            <Button Style="{StaticResource BtnPrimary}" Content="{c:T prep.next}" Command="{Binding GoStepCmd}" CommandParameter="0" HorizontalAlignment="Right"/>
          </StackPanel>

          <StackPanel Visibility="{Binding IsStep0, Converter={StaticResource Vis}}">
            <TextBlock Text="{c:T dev.title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{c:T dev.lead}" Style="{StaticResource Lead}"/>
            <Border Style="{StaticResource Note}" Tag="bad" Visibility="{Binding HasScanError, Converter={StaticResource Vis}}">
              <TextBlock Text="{Binding ScanError}"/>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding NoDevices, Converter={StaticResource Vis}}" Padding="20,30">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="◉" FontSize="34" Foreground="{StaticResource Blue}" HorizontalAlignment="Center"/>
                <TextBlock Text="{c:T dev.searching}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,6"/>
              </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Devices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource Plain}" Command="{Binding DataContext.SelectDeviceCmd, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}">
                    <Border x:Name="card" Style="{StaticResource Card}" Padding="16">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="58" Height="34" CornerRadius="10" Background="#33393F52" VerticalAlignment="Top" Margin="0,4,16,0">
                          <Grid>
                            <Ellipse Width="16" Height="16" Fill="#E0E3EE"/>
                            <Ellipse Width="5" Height="5" Fill="{StaticResource Ok}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,6"/>
                          </Grid>
                        </Border>
                        <StackPanel Grid.Column="1">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="15.5" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Serial}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Faint}" Margin="10,3,0,0"/>
                          </StackPanel>
                          <WrapPanel Margin="0,8,0,0">
                            <Border Style="{StaticResource Badge}" Tag="blue"><TextBlock Text="{Binding TransportText}" Foreground="{StaticResource Blue}"/></Border>
                            <Border Style="{StaticResource Badge}" Tag="{Binding MatchTone}" Visibility="{Binding HasMatch, Converter={StaticResource Vis}}"><TextBlock Text="{Binding MatchText}"/></Border>
                            <Border Style="{StaticResource Badge}" Tag="{Binding SystemTone}" Visibility="{Binding HasSystem, Converter={StaticResource Vis}}"><TextBlock Text="{Binding SystemText}"/></Border>
                            <Border Style="{StaticResource Badge}" Tag="{Binding FirmwareTone}" Visibility="{Binding HasFirmware, Converter={StaticResource Vis}}"><TextBlock Text="{Binding FirmwareText}"/></Border>
                          </WrapPanel>
                          <TextBlock x:Name="hint" Text="{Binding HintText}" FontSize="12.5" Foreground="{StaticResource Warn}" Visibility="{Binding HasHint, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                        <TextBlock x:Name="mark" Grid.Column="2" Text="○" FontSize="20" Foreground="{StaticResource Line2}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                      </Grid>
                    </Border>
                  </Button>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                      <Setter TargetName="card" Property="BorderBrush" Value="#A6FFC76B"/>
                      <Setter TargetName="card" Property="BorderThickness" Value="1.5"/>
                      <Setter TargetName="mark" Property="Text" Value="●"/>
                      <Setter TargetName="mark" Property="Foreground" Value="{StaticResource Accent}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HintTone}" Value="bad"><Setter TargetName="hint" Property="Foreground" Value="{StaticResource Bad}"/></DataTrigger>
                    <DataTrigger Binding="{Binding HintTone}" Value="plain"><Setter TargetName="hint" Property="Foreground" Value="{StaticResource Muted}"/></DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Note}" Tag="ok" Visibility="{Binding ManualChosen, Converter={StaticResource Vis}}">
              <TextBlock Text="{Binding ManualChosenText}"/>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding ShowWifi, Converter={StaticResource Vis}}">
              <StackPanel>
                <TextBlock Text="{c:T dev.wifi.title}" Style="{StaticResource H2}"/>
                <Border Height="10"/>
                <StackPanel Orientation="Horizontal">
                  <TextBox Text="{Binding WifiAddr, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
                  <Button Style="{StaticResource BtnSmall}" Content="{c:T dev.connect}" Command="{Binding ConnectWifiCmd}" Margin="10,0,0,0"/>
                  <Button Style="{StaticResource BtnGhostSmall}" Content="{c:T dev.find}" Command="{Binding FindOnNetworkCmd}" Margin="4,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding WifiMessage}" Style="{StaticResource Small}" Margin="0,8,0,0" Visibility="{Binding HasWifiMessage, Converter={StaticResource Vis}}"/>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Button Style="{StaticResource Chip}" Content="{c:T dev.tab.serial}" Command="{Binding ManualTabCmd}" CommandParameter="0" Tag="{Binding ManualSerialTab, Converter={StaticResource On}}"/>
                  <Button Style="{StaticResource Chip}" Content="{c:T dev.tab.list}" Command="{Binding ManualTabCmd}" CommandParameter="1" Tag="{Binding ManualListTab, Converter={StaticResource On}}"/>
                </StackPanel>
                <StackPanel Visibility="{Binding ManualSerialTab, Converter={StaticResource Vis}}">
                  <TextBlock Text="{c:T dev.serial.text}" Style="{StaticResource Small}" Margin="0,0,0,10"/>
                  <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding SerialInput, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
                    <Button Style="{StaticResource BtnSmall}" Content="{c:T dev.identify}" Command="{Binding IdentifySerialCmd}" Margin="10,0,0,0"/>
                  </StackPanel>
                  <Border Style="{StaticResource Note}" Tag="{Binding SerialTone}" Margin="0,12,0,0" Visibility="{Binding HasSerialResult, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding SerialResult}"/>
                  </Border>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ProfileCards}" Visibility="{Binding ManualListTab, Converter={StaticResource Vis}}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Style="{StaticResource Plain}" Margin="0,0,10,0" Command="{Binding DataContext.ChooseManualCmd, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}">
                        <Border x:Name="b" CornerRadius="12" Padding="13" BorderThickness="1" BorderBrush="{StaticResource Line}" Background="#08FFFFFF">
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding ConnText}" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="0,3,0,0"/>
                          </StackPanel>
                        </Border>
                      </Button>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <Setter TargetName="b" Property="BorderBrush" Value="#A6FFC76B"/><Setter TargetName="b" Property="Background" Value="#12FFC76B"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <DockPanel LastChildFill="False">
              <TextBlock DockPanel.Dock="Left" Text="{c:T dev.notfound}" Foreground="{StaticResource Warn}" FontSize="13" VerticalAlignment="Center"
                         Visibility="{Binding NoDeviceFound, Converter={StaticResource Vis}}"/>
              <Button DockPanel.Dock="Left" Style="{StaticResource BtnGhost}" Content="{c:T nav.back}" Command="{Binding GoStepCmd}" CommandParameter="-1"/>
              <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="{c:T dev.next}" Command="{Binding GoStepCmd}" CommandParameter="1"
                      IsEnabled="{Binding Step1Enabled}"/>
            </DockPanel>
          </StackPanel>

          <!-- ============ step 2: the system -->
          <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource Vis}}">
            <TextBlock Text="{c:T sys.title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{c:T sys.lead}" Style="{StaticResource Lead}"/>
            <DockPanel Margin="0,0,0,12">
              <Border Style="{StaticResource Badge}" Tag="blue" VerticalAlignment="Center"><TextBlock Text="{Binding Profile.Name}" Foreground="{StaticResource Blue}"/></Border>
              <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowBeta, Mode=OneWay}" Command="{Binding ToggleBetaCmd}" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{c:T sys.beta}" Foreground="{StaticResource Muted}" FontSize="12.5"/>
              </CheckBox>
              <Button Style="{StaticResource BtnGhostSmall}" Content="{c:T sys.refresh}" Command="{Binding LoadReleasesCmd}" HorizontalAlignment="Right"/>
            </DockPanel>
            <Border Style="{StaticResource Card}" Visibility="{Binding ReleasesLoading, Converter={StaticResource Vis}}">
              <TextBlock Text="{c:T sys.loading}" Foreground="{StaticResource Muted}"/>
            </Border>
            <Border Style="{StaticResource Note}" Tag="bad" Visibility="{Binding HasReleasesError, Converter={StaticResource Vis}}">
              <TextBlock Text="{Binding ReleasesError}"/>
            </Border>
            <Border Style="{StaticResource Note}" Tag="warn" Visibility="{Binding NoReleases, Converter={StaticResource Vis}}">
              <TextBlock Text="{c:T sys.none}"/>
            </Border>
            <ItemsControl ItemsSource="{Binding DeviceReleases}" Margin="0,0,0,6">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource Plain}" Margin="0,0,0,8" Command="{Binding DataContext.SelectReleaseCmd, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Tag}">
                    <Border x:Name="b" CornerRadius="12" Padding="16,13" BorderThickness="1" BorderBrush="{StaticResource Line}" Background="#06FFFFFF">
                      <DockPanel>
                        <Grid Width="18" Height="18" Margin="0,0,14,0" VerticalAlignment="Center">
                          <Ellipse x:Name="ring" Stroke="{StaticResource Line2}" StrokeThickness="2"/>
                          <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource Accent}" Visibility="Collapsed"/>
                        </Grid>
                        <StackPanel>
                          <WrapPanel>
                            <TextBlock Text="{Binding VersionText}" FontSize="14.5" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <Border Style="{StaticResource Badge}" Tag="ok" Margin="0" Visibility="{Binding Latest, Converter={StaticResource Vis}}"><TextBlock Text="{c:T sys.latest}" Foreground="{StaticResource Ok}"/></Border>
                            <Border Style="{StaticResource Badge}" Tag="warn" Margin="0" Visibility="{Binding Beta, Converter={StaticResource Vis}}"><TextBlock Text="{c:T sys.betabadge}" Foreground="{StaticResource Warn}"/></Border>
                            <Border Style="{StaticResource Badge}" Tag="blue" Margin="6,0,0,0" Visibility="{Binding Downloaded, Converter={StaticResource Vis}}"><TextBlock Text="{c:T sys.ondisk}" Foreground="{StaticResource Blue}"/></Border>
                          </WrapPanel>
                          <TextBlock Text="{Binding MetaText}" FontSize="12" Foreground="{StaticResource Faint}" Margin="0,4,0,0"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </Button>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                      <Setter TargetName="b" Property="BorderBrush" Value="#A6FFC76B"/><Setter TargetName="b" Property="Background" Value="#0DFFC76B"/>
                      <Setter TargetName="ring" Property="Stroke" Value="{StaticResource Accent}"/><Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource BtnGhostSmall}" Content="{Binding OlderText}" Command="{Binding ToggleOlderCmd}" HorizontalAlignment="Left" Margin="0,0,0,10" Visibility="{Binding HasOlder, Converter={StaticResource Vis}}"/>
            <Border Style="{StaticResource Card}" Visibility="{Binding IsDownloading, Converter={StaticResource Vis}}">
              <StackPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhostSmall}" Content="{c:T sys.cancel}" Command="{Binding CancelDownloadCmd}"/>
                  <TextBlock Text="{Binding DownloadText}" FontWeight="Medium" VerticalAlignment="Center"/>
                </DockPanel>
                <ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}" Margin="0,10,0,10"/>
                <TextBlock Text="{c:T sys.savedto}" FontSize="12" Foreground="{StaticResource Faint}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Note}" Tag="ok" Visibility="{Binding HasWorkspace, Converter={StaticResource Vis}}">
              <TextBlock Text="{Binding WorkspaceText}"/>
            </Border>
            <DockPanel>
              <Button Style="{StaticResource BtnGhost}" Content="{c:T nav.back}" Command="{Binding GoStepCmd}" CommandParameter="0" IsEnabled="{Binding NotRunning}"/>
              <Button Style="{StaticResource BtnGhostSmall}" Content="{c:T sys.local}" Command="{Binding PickLocalCmd}" Margin="6,0,0,0"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource BtnPrimary}" Content="{Binding DownloadButtonText}" Command="{Binding PrepareReleaseCmd}" Visibility="{Binding ShowDownload, Converter={StaticResource Vis}}"/>
                <Button Style="{StaticResource BtnPrimary}" Content="{c:T sys.next}" Command="{Binding NextFromSystemCmd}" Visibility="{Binding ShowSystemNext, Converter={StaticResource Vis}}"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>

          <!-- ============ step 3: Google services -->
          <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource Vis}}">
            <TextBlock Text="{c:T g.title}" Style="{StaticResource H1}"/>
            <TextBlock Text="{c:T g.lead}" Style="{StaticResource Lead}"/>
            <Border Style="{StaticResource Card}">
              <DockPanel>
                <Border DockPanel.Dock="Left" Width="46" Height="46" CornerRadius="12" Background="White" VerticalAlignment="Top" Margin="0,0,16,0">
                  <TextBlock Text="G" FontSize="24" FontWeight="Bold" Foreground="#4285F4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding GappsEnabled, Mode=OneWay}" Command="{Binding ToggleGappsCmd}" VerticalAlignment="Top"/>
                <StackPanel Margin="0,0,16,0">
                  <TextBlock Text="{c:T g.toggle}" Style="{StaticResource H2}"/>
                  <TextBlock Text="{c:T g.toggle.text}" Style="{StaticResource Small}" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <StackPanel Visibility="{Binding GappsEnabled, Converter={StaticResource Vis}}">
              <Border Style="{StaticResource Card}" Visibility="{Binding HasGappsZip, Converter={StaticResource Vis}}">
                <StackPanel>
                  <TextBlock Text="{c:T g.file}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                  <TextBlock Text="{Binding GappsZipName}" FontFamily="{StaticResource Mono}" FontSize="13" Margin="0,8,0,4"/>
                  <TextBlock Text="{Binding GappsZipMeta}" FontSize="12" Foreground="{StaticResource Faint}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource BtnSmall}" Content="{c:T g.download}" Command="{Binding DownloadGappsCmd}" IsEnabled="{Binding GappsBusy, Converter={x:Static v:Not.Instance}}"/>
                    <Button Style="{StaticResource BtnGhostSmall}" Content="{c:T g.pick}" Command="{Binding PickGappsCmd}" Margin="6,0,0,0" IsEnabled="{Binding GappsBusy, Converter={x:Static v:Not.Instance}}"/>
                  </StackPanel>
                  <StackPanel Margin="0,12,0,0" Visibility="{Binding GappsBusy, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding GappsProgressText}" Style="{StaticResource Small}"/>
                    <ProgressBar Value="{Binding GappsProgress, Mode=OneWay}" Margin="0,6,0,0"/>
                  </StackPanel>
                  <Border Style="{StaticResource Note}" Margin="0,12,0,0" Visibility="{Binding HasGappsState, Converter={StaticResource Vis}}">
                    <Border.Tag>
                      <Binding Path="GappsOk" Converter="{x:Static v:OkBad.Instance}"/>
                    </Border.Tag>
                    <TextBlock Text="{Binding GappsState}"/>
                  </Border>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Note}" Tag="warn" Visibility="{Binding HasGappsZip, Converter={StaticResource NotVis}}">
                <TextBlock Text="{c:T g.nolist}"/>
              </Border>
              <Border Style="{StaticResource Note}" Tag="{Binding PlanTone}">
                <TextBlock Text="{Binding PlanText}"/>
              </Border>
              <StackPanel Visibility="{Binding LumenInstalled, Converter={StaticResource Vis}}">
                <TextBlock Text="{c:T g.separate}" Style="{StaticResource Small}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                  <Button Style="{StaticResource BtnSmall}" Content="{c:T g.add}" Command="{Binding AddGappsCmd}" IsEnabled="{Binding CanAddGapps}"/>
                  <Button Style="{StaticResource BtnGhostSmall}" Content="{c:T g.remove}" Command="{Binding RemoveGappsCmd}" IsEnabled="{Binding CanRemoveGapps}" Margin="6,0,0,0"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
            <DockPanel>
              <Button Style="{StaticResource BtnGhost}" Content="{c:T nav.back}" Command="{Binding GoStepCmd}" CommandParameter="1" IsEnabled="{Binding NotRunning}"/>
              <Button Style="{StaticResource BtnPrimary}" Content="{c:T g.next}" Command="{Binding GoStepCmd}" CommandParameter="3" HorizontalAlignment="Right"/>
            </DockPanel>
          </StackPanel>

          <!-- ============ step 4: install -->
          <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding InstallTitle}" Style="{StaticResource H1}"/>
            <TextBlock Text="{c:T inst.lead}" Style="{StaticResource Lead}"/>

            <StackPanel Visibility="{Binding ShowSummary, Converter={StaticResource Vis}}">
              <Border Style="{StaticResource Card}">
                <ItemsControl ItemsSource="{Binding Summary}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Key}" Foreground="{StaticResource Muted}" FontSize="13.5"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13.5"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <Border Style="{StaticResource Note}" Tag="warn"><TextBlock Text="{c:T inst.wipe}"/></Border>
              <Border Style="{StaticResource Note}" Tag="bad" Visibility="{Binding HasBlockedReason, Converter={StaticResource Vis}}">
                <TextBlock Text="{Binding InstallBlockedReason}"/>
              </Border>
              <DockPanel>
                <Button Style="{StaticResource BtnGhost}" Content="{c:T nav.back}" Command="{Binding GoStepCmd}" CommandParameter="2" IsEnabled="{Binding NotRunning}"/>
                <Button Style="{StaticResource BtnPrimary}" Content="{c:T inst.start}" Command="{Binding StartInstallCmd}" IsEnabled="{Binding CanInstall}" HorizontalAlignment="Right"/>
              </DockPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding ShowRun, Converter={StaticResource Vis}}">
              <Border CornerRadius="14" Padding="16" Margin="0,0,0,14" BorderThickness="1" Background="#1A5FD39A" BorderBrush="#665FD39A"
                      Visibility="{Binding ResultOk, Converter={StaticResource Vis}}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhostSmall}" Content="{c:T inst.waitg.skip}" Command="{Binding SkipWaitingGappsCmd}"
                          VerticalAlignment="Center" Visibility="{Binding WaitingGapps, Converter={StaticResource Vis}}"/>
                  <Button DockPanel.Dock="Right" Style="{StaticResource BtnSmall}" Content="{c:T inst.addgoogle}" Command="{Binding GoogleAfterCmd}"
                          VerticalAlignment="Center" Visibility="{Binding OfferGoogleAfter, Converter={StaticResource Vis}}"/>
                  <TextBlock DockPanel.Dock="Left" Text="✔" FontSize="24" Foreground="{StaticResource Ok}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                  <StackPanel>
                    <TextBlock Text="{Binding ResultTitle}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ResultText}" Style="{StaticResource Small}" FontSize="13" Margin="0,3,10,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border CornerRadius="14" Padding="16" Margin="0,0,0,14" BorderThickness="1" Background="#17FF6B7D" BorderBrush="#66FF6B7D"
                      Visibility="{Binding ResultBad, Converter={StaticResource Vis}}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="⛔" FontSize="22" Foreground="{StaticResource Bad}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                  <StackPanel>
                    <TextBlock Text="{Binding ResultTitle}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ResultText}" Style="{StaticResource Small}" FontSize="13" Margin="0,3,0,0"/>
                  </StackPanel>
                </DockPanel>
              </Border>

              <Border Style="{StaticResource Card}" Padding="16" Visibility="{Binding ShowPipeline, Converter={StaticResource Vis}}">
                <ItemsControl ItemsSource="{Binding Pipeline}" ItemTemplate="{StaticResource PipeStep}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
              </Border>
              <Border Style="{StaticResource Note}" Tag="plain" Visibility="{Binding ShowChainNote, Converter={StaticResource Vis}}">
                <TextBlock Text="{c:T chain.note}"/>
              </Border>
              <Border Style="{StaticResource Note}" Tag="plain" Visibility="{Binding L.IsZh, Converter={StaticResource Vis}}">
                <TextBlock Text="{c:T inst.lang.note}"/>
              </Border>

              <Border CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource Line}" Background="#D904050C" Height="340" Margin="0,0,0,12">
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="12">
                  <ItemsControl ItemsSource="{Binding Log}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock x:Name="t" Text="{Binding Text}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="#C4C8E8" TextWrapping="Wrap"/>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding Kind}" Value="Cmd"><Setter TargetName="t" Property="Foreground" Value="{StaticResource Blue}"/></DataTrigger>
                          <DataTrigger Binding="{Binding Kind}" Value="Ok"><Setter TargetName="t" Property="Foreground" Value="#9CE8C0"/></DataTrigger>
                          <DataTrigger Binding="{Binding Kind}" Value="Warn"><Setter TargetName="t" Property="Foreground" Value="{StaticResource Warn}"/></DataTrigger>
                          <DataTrigger Binding="{Binding Kind}" Value="Stop"><Setter TargetName="t" Property="Foreground" Value="{StaticResource Bad}"/><Setter TargetName="t" Property="FontWeight" Value="Bold"/></DataTrigger>
                          <DataTrigger Binding="{Binding Kind}" Value="Answer"><Setter TargetName="t" Property="Foreground" Value="White"/><Setter TargetName="t" Property="Background" Value="#1AFFC76B"/></DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
              <DockPanel>
                <Button Style="{StaticResource BtnGhost}" Content="{c:T nav.back}" Command="{Binding GoStepCmd}" CommandParameter="2" Visibility="{Binding Running, Converter={StaticResource NotVis}}"/>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Running, Converter={StaticResource Vis}}">
                  <TextBlock Text="{Binding RunningText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Style="{StaticResource BtnDanger}" Padding="11,6" FontSize="12.5" Content="{c:T inst.stop}" Command="{Binding StopCmd}" Visibility="{Binding Running, Converter={StaticResource Vis}}"/>
                  <Button Style="{StaticResource BtnGhostSmall}" Content="{c:T inst.copy}" Command="{Binding CopyLogCmd}" Visibility="{Binding Running, Converter={StaticResource NotVis}}"/>
                </StackPanel>
              </DockPanel>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ================================================================ busy -->
    <Grid Background="#8C000000" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
      <Border Background="#141A38" BorderBrush="{StaticResource Line2}" BorderThickness="1" CornerRadius="18" Padding="28"
              HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
        <StackPanel>
          <ProgressBar Value="{Binding BusyProgress, Mode=OneWay}" IsIndeterminate="{Binding BusyIndeterminate, Mode=OneWay}"/>
          <TextBlock Text="{Binding Busy}" TextAlignment="Center" Margin="0,16,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
