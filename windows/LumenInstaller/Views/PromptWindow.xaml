<Window x:Class="LumenInstaller.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:LumenInstaller.Core"
        Title="Lumen Installer" Width="640" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="#141A38" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
  <StackPanel Margin="24">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
      <TextBlock x:Name="Glyph" Text="?" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
      <TextBlock x:Name="Header" Text="{c:T prompt.title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </StackPanel>
    <Border x:Name="ContextBox" Background="#40000000" CornerRadius="10" Padding="12" Margin="0,0,0,14">
      <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
        <TextBox x:Name="ContextText" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" Padding="0"
                 Foreground="#CDD1F0" FontSize="13"/>
      </ScrollViewer>
    </Border>
    <TextBlock x:Name="Question" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

    <!-- yes / no -->
    <StackPanel x:Name="YesNo" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
      <Button Style="{StaticResource Btn}" Content="{c:T prompt.no}" Click="No_Click" IsCancel="True" MinWidth="90"/>
      <Button Style="{StaticResource BtnPrimary}" Content="{c:T prompt.yes}" Click="Yes_Click" IsDefault="True" MinWidth="90" Margin="10,0,0,0"/>
    </StackPanel>

    <!-- a word to type (ERASE, WRITE…): the user types it, the button stays off until it matches -->
    <DockPanel x:Name="Word" Visibility="Collapsed">
      <TextBlock x:Name="WordLabel" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <TextBox x:Name="WordBox" Width="170" FontFamily="{StaticResource Mono}" TextChanged="WordBox_TextChanged" KeyDown="WordBox_KeyDown"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource Btn}" Content="{c:T prompt.cancel}" Click="No_Click" IsCancel="True"/>
        <Button x:Name="Continue" Style="{StaticResource BtnDanger}" Content="{c:T prompt.continue}" Click="Word_Click" IsEnabled="False" Margin="10,0,0,0"/>
      </StackPanel>
    </DockPanel>

    <!-- anything else -->
    <DockPanel x:Name="Free" Visibility="Collapsed">
      <Button x:Name="FreeButton" DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="{c:T prompt.reply}" Click="Free_Click" IsDefault="True" Margin="10,0,0,0"/>
      <TextBox x:Name="FreeBox"/>
    </DockPanel>
  </StackPanel>
</Window>
